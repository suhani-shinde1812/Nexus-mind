# --- Database ---
DATABASE_URL=postgresql+psycopg2://nexus:nexus@localhost:5432/nexusmind

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Redis (pub/sub + realtime fanout) ---
REDIS_URL=redis://localhost:6379/0

# --- AI ---
# If unset, the AI service falls back to deterministic heuristics so the app
# still works end-to-end without an API key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Firebase Cloud Messaging (mobile push) ---
FCM_SERVER_KEY=
